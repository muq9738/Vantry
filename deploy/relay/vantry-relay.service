[Unit]
Description=Vantry native session and desktop relay
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=vantry-relay
Group=vantry-relay
ExecStart=/opt/vantry/bin/vantry-relay serve --config /etc/vantry/relay.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
StateDirectory=vantry-relay
WorkingDirectory=/var/lib/vantry-relay
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vantry-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
